# DeepSeek API（必填，主 LLM）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Phase 7.5 Model Router：按角色选模型。未设则用默认 deepseek-chat。
# 推荐配置：把"判断/批评"型角色升级到推理模型（如 deepseek-reasoner）
# MODEL_FOR_BRIEF=deepseek-chat
# MODEL_FOR_RESEARCH=deepseek-chat
# MODEL_FOR_DRAFT=deepseek-chat
# MODEL_FOR_QUALITY=deepseek-reasoner    # 评分用推理模型，更稳更准
# MODEL_FOR_RED_TEAM=deepseek-reasoner   # 批判也用推理
# MODEL_FOR_REVISION=deepseek-chat
# MODEL_FOR_FINAL=deepseek-chat
# MODEL_FOR_JUDGE=deepseek-reasoner      # 独立 eval 评估用推理
# MODEL_FOR_PLANNER=deepseek-chat
# MODEL_FOR_DEFAULT=deepseek-chat
# 温度也可按角色覆盖（默认见 src/model_router.py）
# TEMP_FOR_QUALITY=0.0

# 搜索 Provider：当前用 DuckDuckGo（无需 key）
SEARCH_PROVIDER=duckduckgo

# Researcher 模式：
#   react  = LLM 自主选工具（默认；多工具 ReAct 回路）
#   simple = 代码循环调 DDG（旧版，省 token、可控但单工具）
#   rewoo  = 一次性规划 + 纯执行（最省 token，估计降 60%）
RESEARCHER_MODE=react

# ReWOO 并行度（仅 rewoo 模式生效）：0/1=顺序；5=默认并行 5 个工具
REWOO_PARALLEL_WORKERS=5

# Phase 7.4 质量稳定性增强（成本翻倍换稳定/全面）：
# Self-Consistency：quality_eval 跑 N 次取每维度中位数
QUALITY_EVAL_SAMPLES=1            # 1=单次；3=Self-Consistency 推荐值
# Multi-Persona：red_team 用 N 个不同 persona 并行评论后 aggregate
RED_TEAM_PERSONAS=1               # 1=单 critic；3=多视角推荐值

ENABLE_EVOLUTION=true
EVOLUTION_MIN_SCORE=7.0

# Phase 7.7 Prompt Injection 防御：
# - 入口 sanitize 用户 query；命中模式时插入告警标记但不阻断
# - 工具结果用 <UNTRUSTED_CONTENT> 标签包装，让 LLM 知道内容来自不可信源
# - 出口检测系统 prompt 泄露
ENABLE_INJECTION_GUARD=true

# 语义缓存开关：相同/相似 query 直接返回历史报告
ENABLE_CACHE=true
CACHE_SIMILARITY_THRESHOLD=0.88   # 命中阈值（余弦相似度，实测 0.88 适合中文同义改写）
CACHE_MIN_SCORE=7.0               # 只缓存 overall ≥ 该分数的研究

# RAG（本地知识库）开关：
#   true  = ReAct 工具集挂载 local_knowledge_search（默认）
#   false = 仅外部工具，跳过本地检索
ENABLE_RAG=true

# 嵌入模型：默认 BGE-small-zh-v1.5；首次运行会从 HuggingFace 下载 ~120MB
# EMBED_MODEL=BAAI/bge-small-zh-v1.5

# 国内访问 HuggingFace 慢时可用镜像：
# HF_ENDPOINT=https://hf-mirror.com

# LangSmith（可选，可观测性）
# LANGSMITH_API_KEY=
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=deep-research-agent
